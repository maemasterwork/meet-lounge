# Copy to .env.local. Both values are public by design (safe in the browser); security comes from RLS.
# Find them in Supabase: Project Settings -> API. Use the "anon" / publishable key. NEVER the service_role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Web push (optional). Public key from:  npx web-push generate-vapid-keys   (the private key goes in Edge Function secrets, never here)
VITE_VAPID_PUBLIC_KEY=
